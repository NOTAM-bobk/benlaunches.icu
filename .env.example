# PayPal checkout (server side — never prefix these with VITE_, they must not
# reach the browser). Copy this file to .env.local for local development, and
# set the same names in Vercel → Project → Settings → Environment Variables.
#
# Get both values from https://developer.paypal.com/dashboard/applications
# (Sandbox tab for testing, Live tab for real payments).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# sandbox (default) or production. Leave it unset while testing.
PAYPAL_ENV=sandbox

# Optional. Prices come from config/services.json; only the currency code lives here.
# PAYPAL_CURRENCY=USD

# Purchase fulfillment queue. Point this at the same Cloudflare Worker used by
# the Admin page. The password is server-only and must match ADMIN_PASSWORD.
# VOTES_API_URL=https://your-worker.example.workers.dev
# PAYMENTS_ADMIN_PASSWORD=
